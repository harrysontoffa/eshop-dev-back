// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CLIENT_CONNECTE
}

model Utilisateur {
  idUtilisateur String   @id @default(uuid()) @map("id_utilisateur") @db.Uuid
  nom           String
  prenom        String
  role          Role     @default(CLIENT_CONNECTE)
  mail          String   @unique
  telephone     String
  motDePasse    String   @map("mot_de_passe")
  dateCreation  DateTime @default(now()) @map("date_creation")

  pageGereePar            Page[]       @relation("pageGereePar")
  commandesGereesParAdmin Commande[]   @relation("commandesGereesParAdmin")
  commandesDuClient       Commande[]   @relation("commandesDuClient")
  adresse                 Adresse[]
  message                 Message[]
  articleCreeParAdmin     Article[]    @relation("articleCreeParAdmin")
  clientEmetAvis          Avis[]       @relation("clientEmetAvis")
  adminModereAvis         Avis[]       @relation("adminModereAvis")
  favori                  Favori[]
  producteur              Producteur[]
}

model Adresse {
  idAdresse  String @id @default(uuid()) @map("id_adresse") @db.Uuid
  rue        String
  codePostal String @map("code_postal")
  ville      String
  pays       String

  commande      Commande[]
  idUtilisateur String?      @map("id_utilisateur") @db.Uuid
  utilisateur   Utilisateur? @relation(fields: [idUtilisateur], references: [idUtilisateur])
}

model Message {
  idMessage String   @id @default(uuid()) @map("id_message") @db.Uuid
  nom       String
  prenom    String
  email     String
  sujet     String
  contenu   String   @db.Text
  dateEnvoi DateTime @default(now()) @map("date_envoi")

  idUtilisateur String?      @map("id_utilisateur") @db.Uuid
  utilisateur   Utilisateur? @relation(fields: [idUtilisateur], references: [idUtilisateur])
}

enum StatutCommande {
  EN_ATTENTE
  PAYEE
  EN_PREPARATION
  LIVREE
  ANNULEE
  ECHOUEE
}

model Commande {
  idCommande       String         @id @default(uuid()) @map("id_commande") @db.Uuid
  dateCommande     DateTime       @default(now()) @map("date_commande")
  statut           StatutCommande @default(EN_ATTENTE)
  montantTotal     Decimal        @map("montant_total") @db.Decimal(10, 2)
  emailContact     String         @map("email_contact")
  nomContact       String         @map("nom_contact")
  prenomContact    String         @map("prenom_contact")
  telephoneContact String         @map("telephone_contact")

  LigneCommande               LigneCommande[]
  paiement                    Paiement[]
  idAdresse                   String          @map("id_adresse") @db.Uuid
  adresse                     Adresse         @relation(fields: [idAdresse], references: [idAdresse])
  idUtilisateurAdmin          String?         @map("id_utilisateur_admin") @db.Uuid
  utilisateurAdmin            Utilisateur?    @relation("commandesGereesParAdmin", fields: [idUtilisateurAdmin], references: [idUtilisateur])
  idUtilisateurClientConnecte String?         @map("id_utilisateur_client_connectee") @db.Uuid
  utilisateurClient           Utilisateur?    @relation("commandesDuClient", fields: [idUtilisateurClientConnecte], references: [idUtilisateur])
}

model Page {
  idPage   String @id @default(uuid()) @map("id_page") @db.Uuid
  titre    String
  slug     String @unique
  contenu  String @db.Text
  typePage String @map("type_page")

  idUtilisateurAdmin String      @map("id_utilisateur_admin") @db.Uuid
  utilisateurAdmin   Utilisateur @relation("pageGereePar", fields: [idUtilisateurAdmin], references: [idUtilisateur])
}

model Article {
  idArticle       String   @id @default(uuid()) @map("id_article") @db.Uuid
  titre           String
  slug            String   @unique
  contenu         String   @db.Text
  imageUrl        String   @map("image_url")
  datePublication DateTime @default(now()) @map("date_publication")

  idUtilisateurAdmin String      @map("id_utilisateur_admin") @db.Uuid
  utilisateurAdmin   Utilisateur @relation("articleCreeParAdmin", fields: [idUtilisateurAdmin], references: [idUtilisateur])
}

model Avis {
  idAvis      String   @id @default(uuid()) @map("id_avis") @db.Uuid
  note        Int
  commentaire String?
  statut      String
  dateAvis    DateTime @default(now()) @map("date_avis")

  idUtilisateurClientConnectee String        @map("id_utilisateur_client_connectee") @db.Uuid
  utilisateurClientConnectee   Utilisateur   @relation("clientEmetAvis", fields: [idUtilisateurClientConnectee], references: [idUtilisateur])
  idUtilisateurAdmin           String?       @map("id_utilisateur_admin") @db.Uuid
  UtilisateurAdmin             Utilisateur?  @relation("adminModereAvis", fields: [idUtilisateurAdmin], references: [idUtilisateur])
  idLigne                      String        @map("id_ligne") @db.Uuid
  ligne                        LigneCommande @relation(fields: [idLigne], references: [idLigne])
}

model LigneCommande {
  idLigne      String  @id @default(uuid()) @map("id_ligne") @db.Uuid
  quantite     Int
  prixUnitaire Decimal @map("prix_unitaire") @db.Decimal(10, 2)
  sousTotal    Decimal @map("sous_total") @db.Decimal(10, 2)
  avis         Avis[]

  idCommande String   @map("id_commande") @db.Uuid
  commande   Commande @relation(fields: [idCommande], references: [idCommande])
  idProduit  String   @map("id_produit") @db.Uuid
  produit    Produit  @relation(fields: [idProduit], references: [idProduit])
}

model Produit {
  idProduit    String  @id @default(uuid()) @map("id_produit") @db.Uuid
  nom          String
  description  String
  prixUnitaire Decimal @map("prix_unitaire") @db.Decimal(10, 2)
  stock        Int
  photoUrl     String  @map("photo_url")

  LigneCommande LigneCommande[]
  favori        Favori[]
  idProducteur  String          @map("id_producteur") @db.Uuid
  producteur    Producteur      @relation(fields: [idProducteur], references: [idProducteur])
}

model Favori {
  idFavori  String   @id @default(uuid()) @map("id_favori") @db.Uuid
  dateAjout DateTime @default(now()) @map("date_ajout")

  idUtilisateur String      @map("id_utilisateur") @db.Uuid
  utilisateur   Utilisateur @relation(fields: [idUtilisateur], references: [idUtilisateur])
  idProduit     String      @map("id_produit") @db.Uuid
  produit       Produit     @relation(fields: [idProduit], references: [idProduit])

  @@unique([idUtilisateur, idProduit])
}

model Producteur {
  idProducteur String @id @default(uuid()) @map("id_producteur") @db.Uuid
  nom          String
  description  String
  specialite   String

  idUtilisateur String      @map("id_utilisateur") @db.Uuid
  utilisateur   Utilisateur @relation(fields: [idUtilisateur], references: [idUtilisateur])
  produit       Produit[]
}

enum StatutPaiement {
  EN_ATTENTE
  EN_COURS
  VALIDE
  REFUSE
}

model Paiement {
  idPaiement      String         @id @default(uuid()) @map("id_paiement") @db.Uuid
  montant         Decimal        @db.Decimal(10, 2)
  datePaiement    DateTime?      @map("date_paiement")
  methode         String
  stripeSessionId String?        @unique @map("stripe_session_id")
  statut          StatutPaiement @default(EN_ATTENTE)

  idCommande String       @map("id_commande") @db.Uuid
  commande   Commande     @relation(fields: [idCommande], references: [idCommande])
  traiterPar TraiterPar[]
}

model PasserellePaiement {
  idPasserelle String       @id @default(uuid()) @map("id_passerelle") @db.Uuid
  nom          String
  type         String
  urlWebhook   String       @map("url_webhook")
  traiterPar   TraiterPar[]
}

model TraiterPar {
  idPaiement String   @map("id_paiement") @db.Uuid
  paiement   Paiement @relation(fields: [idPaiement], references: [idPaiement])

  idPasserelle String             @map("id_passerelle") @db.Uuid
  passerelle   PasserellePaiement @relation(fields: [idPasserelle], references: [idPasserelle])

  @@id([idPaiement, idPasserelle])
}

model NewsletterAbonne {
  idAbonne        String   @id @default(uuid()) @map("id_abonne") @db.Uuid
  email           String   @unique
  dateInscription DateTime @default(now()) @map("date_inscription")
  consentement    Boolean
}
